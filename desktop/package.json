{
  "name": "@innexgrid/desktop",
  "version": "1.0.0",
  "description": "InnexGrid Desktop Application",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"NEXT,ELECTRON\" -c \"blue,green\" \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "cd ../frontend && npm run dev",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build": "npm run build:next && npm run build:electron",
    "build:next": "cd ../frontend && npm run build",
    "build:electron": "electron-builder",
    "start": "electron .",
    "lint": "eslint electron/**/*.js"
  },
  "build": {
    "appId": "com.innexar.innexgrid",
    "productName": "InnexGrid",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "../frontend/.next/**/*",
      "../frontend/public/**/*",
      "../frontend/package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  },
  "keywords": [
    "desktop",
    "electron",
    "depin",
    "blockchain"
  ],
  "author": "Innexar",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "systeminformation": "^5.27.11",
    "axios": "^1.6.2"
  }
}
